# Template for secret.yml (which is gitignored). Copy it and fill in real values:
#   cp k8s/secret.yml.example k8s/secret.yml
apiVersion: v1
kind: Secret
metadata:
  name: thinkboard-backend-secret
  namespace: thinkboard
type: Opaque
stringData:
  MONGO_URI: mongodb://mongo:27017/thinkboard
  SECRET_KEY: your_jwt_secret
  UPSTASH_REDIS_REST_URL: your_upstash_redis_rest_url
  UPSTASH_REDIS_REST_TOKEN: your_upstash_redis_rest_token
  GOOGLE_CLIENT_ID: your_google_client_id
  GOOGLE_CLIENT_SECRET: your_google_client_secret
